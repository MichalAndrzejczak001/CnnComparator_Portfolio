{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "model": { "type": "string" },
    "dataset": { "type": "string" },
    "epochs": { "type": "integer" },
    "batch_size": { "type": "integer" },
    "learning_rate": { "type": "number" },
    "train_loss_per_epoch": { "type": "array", "items": { "type": "number" } },
    "val_loss_per_epoch": { "type": "array", "items": { "type": "number" } },
    "train_accuracy_per_epoch": { "type": "array", "items": { "type": "number" } },
    "val_accuracy_per_epoch": { "type": "array", "items": { "type": "number" } },
    "test_loss": { "type": "number" },
    "test_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "training_time_seconds": { "type": "number" },
    "confusion_matrix": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "integer" } }
    },
    "note": { "type": ["string", "null"] },
    "model_id": { "type": "string" },
    "created_at": { "type": "string" },
    "sample_gradcams": { "type": "array" },
    "param_count": { "type": "integer" },
    "model_size_bytes": { "type": "integer" },
    "inference_latency_ms": { "type": "number" },
    "training_throughput_images_per_sec": { "type": "number" },
    "calibration_curve": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "bin_min": { "type": "number" },
          "bin_max": { "type": "number" },
          "avg_confidence": { "type": ["number", "null"] },
          "accuracy": { "type": ["number", "null"] },
          "count": { "type": "integer" }
        },
        "required": ["bin_min", "bin_max", "avg_confidence", "accuracy", "count"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id", "model", "dataset", "epochs", "batch_size", "learning_rate",
    "train_loss_per_epoch", "val_loss_per_epoch", "train_accuracy_per_epoch", "val_accuracy_per_epoch",
    "test_loss", "test_accuracy",
    "training_time_seconds", "confusion_matrix", "note", "model_id", "created_at", "sample_gradcams",
    "param_count", "model_size_bytes", "inference_latency_ms", "training_throughput_images_per_sec", "calibration_curve"
  ],
  "additionalProperties": false
}
