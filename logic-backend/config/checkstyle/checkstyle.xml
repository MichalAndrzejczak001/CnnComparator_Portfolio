<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Deliberately narrow ruleset: catches real defects, not style preferences. This project
    has no established formatting convention to enforce (no existing Spotless/google-java-format
    adoption), so rules here are limited to things that are correctness/maintainability issues
    regardless of formatting style — see logic-backend/build.gradle for how this is wired in.
-->
<module name="Checker">

    <module name="TreeWalker">
        <!-- Dead/misleading imports. -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Classic correctness footguns. -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>
        <module name="EmptyCatchBlock"/>
        <module name="StringLiteralEquality"/>
        <module name="CovariantEquals"/>

        <!-- Dead code. -->
        <module name="UnusedLocalVariable"/>
    </module>
</module>
