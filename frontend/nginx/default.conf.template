server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: unknown paths (client-side routes) serve index.html instead of 404.
    location / {
        try_files $uri /index.html;
    }

    # No trailing slash on the prefix: the frontend calls bare /experiments (list/create)
    # as well as /experiments/{id} etc — a trailing slash here would only match the latter
    # and send bare /experiments through the SPA fallback instead (301 loop on the wrong port).
    location /auth {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /experiments {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /experiments/compare trains all 6 architectures; matches the headroom
        # given to Spring's RestTemplate and the old Vite dev proxy for the same route.
        proxy_read_timeout 120m;
        proxy_send_timeout 120m;

        # Matches logic-backend's spring.servlet.multipart.max-file-size (classify/gradcam uploads).
        client_max_body_size 10m;
    }
}
